@model QuanLyNhanVien.Models.NhanVien

@{
    ViewData["Title"] = "Them nhan vien";
}

<h2 class="mb-3">Them nhan vien moi</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="strTenNhanVien" class="form-label">Ten nhan vien</label>
                <input asp-for="strTenNhanVien" class="form-control" />
                <span asp-validation-for="strTenNhanVien" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="intNamSinh" class="form-label">Nam sinh</label>
                <input asp-for="intNamSinh" class="form-control" type="number" min="1950" max="2010" placeholder="VD: 1995" />
                <span asp-validation-for="intNamSinh" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="boolGioiTinh" class="form-label">Gioi tinh</label>
                <select asp-for="boolGioiTinh" class="form-select">
                    <option value="true">Nam</option>
                    <option value="false">Nu</option>
                </select>
                <span asp-validation-for="boolGioiTinh" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="dblLuong" class="form-label">Luong (VND)</label>
                <input asp-for="dblLuong" class="form-control" type="number" min="1" />
                <span asp-validation-for="dblLuong" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="intTrangThai" class="form-label">Trang thai</label>
                <select asp-for="intTrangThai" asp-items="ViewBag.objSelectTrangThai" class="form-select">
                    <option value="">-- Chon trang thai --</option>
                </select>
                <span asp-validation-for="intTrangThai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="intMaPhongBan" class="form-label">Phong ban</label>
                <select asp-for="intMaPhongBan" asp-items="ViewBag.objSelectPhongBan" class="form-select">
                    <option value="">-- Chon phong ban --</option>
                </select>
                <span asp-validation-for="intMaPhongBan" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Luu</button>
                <a asp-action="Index" class="btn btn-secondary">Huy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
