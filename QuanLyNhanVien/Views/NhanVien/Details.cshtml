@model QuanLyNhanVien.Models.NhanVien
@using QuanLyNhanVien.Enums

@{
    ViewData["Title"] = "Chi tiet nhan vien";
}

<h2 class="mb-3">Chi tiet nhan vien</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Ma nhan vien</dt>
            <dd class="col-sm-8">@Model.intMaNhanVien</dd>

            <dt class="col-sm-4">Ten nhan vien</dt>
            <dd class="col-sm-8">@Model.strTenNhanVien</dd>

            <dt class="col-sm-4">Nam sinh</dt>
            <dd class="col-sm-8">@Model.intNamSinh</dd>

            <dt class="col-sm-4">Gioi tinh</dt>
            <dd class="col-sm-8">@Html.RenderGioiTinh(Model.boolGioiTinh)</dd>

            <dt class="col-sm-4">Luong</dt>
            <dd class="col-sm-8">@Model.dblLuong.ToCurrencyVN()</dd>

            <dt class="col-sm-4">Trang thai</dt>
            <dd class="col-sm-8">@Html.RenderTrangThai(Model.intTrangThai)</dd>

            <dt class="col-sm-4">Phong ban</dt>
            <dd class="col-sm-8">@Model.objPhongBan?.strTenPhongBan</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-intId="@Model.intMaNhanVien" class="btn btn-warning">Chinh sua</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lai</a>
</div>
